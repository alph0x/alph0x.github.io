{
  "git": {
    "deploymentEnabled": {
      "codex/macos15-evaluation": false,
      "codex/macos15-collector-repair": false
    }
  },
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
